{
  "name": "js-ephemeris",
  "version": "1.1.0-dev.0",
  "private": true,
  "description": "JavaScript/TypeScript ephemeris library powered by Taiyin C++/WebAssembly: planetary positions, eclipses, Chinese calendars, BaZi and Ziwei for browsers and Node.js.",
  "type": "module",
  "license": "MPL-2.0",
  "author": "RedSC1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedSC1/js-ephemeris.git"
  },
  "homepage": "https://github.com/RedSC1/js-ephemeris#readme",
  "bugs": {
    "url": "https://github.com/RedSC1/js-ephemeris/issues"
  },
  "keywords": [
    "ephemeris",
    "astronomy",
    "wasm",
    "typescript",
    "chinese-calendar",
    "bazi",
    "ziwei"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "CORE-NOTICE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:types": "npm run build && tsc -p tsconfig.type-tests.json",
    "test": "npm run build && node --test test/unit.test.mjs",
    "test:integration": "npm run build && node --test test/real-wasm.test.mjs",
    "test:astronomy": "npm run build && node --test test/astronomy.test.mjs",
    "test:bazi-reverse": "npm run build && node --test test/bazi-reverse.test.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "format": "prettier --write src scripts test examples docs README.md README.zh-CN.md package.json tsconfig.json",
    "example:browser": "node scripts/serve-example.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3"
  }
}
